#pragma once

// Local-only fallback for the HA long-lived access token.
//
// Copy this file to secrets.h (gitignored — see ../../../.gitignore) and
// fill in your own token. ha_weather::token() reads NVS "ha_token" first
// (settable on-device via 主屏 → 网络设置 → HA Token); this is only used
// when that's empty. It exists because the token is long enough that typing
// it on the on-screen keyboard is impractical — NOT as an invitation to
// hardcode it. A real token got committed here once before (leaked to a
// public fork, since revoked) precisely because it was a compile-time
// constant in a tracked file. secrets.h being gitignored is what prevents
// that from happening again — don't rename/untrack it.
//
// Generate one in HA → Profile → Long-Lived Access Tokens.
inline const char* LOCAL_HA_TOKEN_DEFAULT = "";
